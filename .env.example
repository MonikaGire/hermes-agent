# =============================================
# HERMES AI - Environment Variables Template
# =============================================
# Copy this file to .env and fill in values.
# Never commit .env to version control.

# --- App ---
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# --- Database ---
DATABASE_URL=postgresql://hermes:password@localhost:5432/hermes_db

# --- Redis ---
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Authentication ---
NEXTAUTH_SECRET=your-nextauth-secret-min-32-chars
NEXTAUTH_URL=http://localhost:3000
JWT_SECRET=your-jwt-secret-min-32-chars
JWT_EXPIRES_IN=7d

# --- OpenAI ---
OPENAI_API_KEY=sk-...
OPENAI_ORG_ID=org-...
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=2000

# --- Apollo.io ---
APOLLO_API_KEY=your-apollo-api-key
APOLLO_BASE_URL=https://api.apollo.io/v1

# --- Hunter.io ---
HUNTER_API_KEY=your-hunter-api-key
HUNTER_BASE_URL=https://api.hunter.io/v2

# --- SerpAPI ---
SERPAPI_KEY=your-serpapi-key
SERPAPI_BASE_URL=https://serpapi.com

# --- Clearbit ---
CLEARBIT_API_KEY=sk_...
CLEARBIT_BASE_URL=https://company.clearbit.com/v2

# --- Email / SMTP ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@email.com
SMTP_PASS=your-app-password
SMTP_FROM=HERMES <your@email.com>

# AWS SES (optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
SES_FROM=your@email.com

# SendGrid (optional)
SENDGRID_API_KEY=SG....

# --- Gmail OAuth2 (for inbox polling and reply sending) ---
# Get credentials from Google Cloud Console → APIs & Services → Credentials
# Required scopes: gmail.readonly, gmail.send, gmail.modify
GMAIL_CLIENT_ID=your-google-oauth-client-id
GMAIL_CLIENT_SECRET=your-google-oauth-client-secret
GMAIL_REFRESH_TOKEN=your-gmail-refresh-token
# To obtain refresh token: use OAuth2 Playground at https://developers.google.com/oauthplayground
# Select scope: https://mail.google.com/
# Authorize with your account, then exchange authorization code for tokens

# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_WEBHOOK_URL=https://yourdomain.com/api/telegram/webhook

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# --- BullMQ Queue ---
QUEUE_CONCURRENCY=5
QUEUE_RETRY_ATTEMPTS=3
QUEUE_RETRY_DELAY=5000

# --- Logging ---
LOG_LEVEL=info
LOG_DIR=./logs

# --- Frontend API ---
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_NAME=HERMES
NEXT_PUBLIC_APP_VERSION=1.0.0
