generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// =============================================
// USERS
// =============================================
model User {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  email        String    @unique
  passwordHash String
  role         UserRole  @default(USER)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  approvals  Approval[]
  activities Activity[]
}

enum UserRole {
  ADMIN
  USER
}

// =============================================
// COMPANIES (Prospects)
// =============================================
model Company {
  id              String         @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  website         String?
  industry        String
  country         String
  employeeCount   Int?
  revenueEstimate String?
  linkedinUrl     String?
  logoUrl         String?
  description     String?
  status          ProspectStatus @default(NEW)
  serviceMode     ServiceMode    @default(ERP)
  source          String?
  sourceId        String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  contacts      Contact[]
  research      Research[]
  emails        Email[]
  activities    Activity[]
  painPoints    PainPoint[]
  aeoResearch   AEOResearch[]
  conversations Conversation[]

  @@index([status])
  @@index([industry])
  @@index([country])
  @@index([serviceMode])
}

enum ServiceMode {
  ERP
  AEO
  SEO
}

enum ProspectStatus {
  NEW
  RESEARCHING
  RESEARCHED
  EMAIL_DRAFT
  EMAIL_PENDING
  EMAIL_APPROVED
  EMAIL_SENT
  REPLIED
  CONVERTED
  SKIPPED
}

// =============================================
// CONTACTS
// =============================================
model Contact {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  firstName   String
  lastName    String
  role        String
  email       String?
  phone       String?
  linkedinUrl String?
  isVerified  Boolean  @default(false)
  companyId   String   @db.ObjectId
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])
  emails  Email[]

  @@index([companyId])
  @@index([email])
}

// =============================================
// RESEARCH
// =============================================
model Research {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  companyId       String   @db.ObjectId
  products        String[]
  locations       String[]
  recentNews      Json     @default("[]")
  expansionPlans  String[]
  hiringActivity  String[]
  techStack       String[]
  investments     String[]
  acquisitions    String[]
  summary         String
  confidenceScore Float    @default(0)
  rawData         Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId])
}

// =============================================
// PAIN POINTS
// =============================================
model PainPoint {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  companyId       String   @db.ObjectId
  problem         String
  erpCapability   String
  businessOutcome String
  evidenceScore   Float    @default(0)
  isPrimary       Boolean  @default(false)
  createdAt       DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId])
}

// =============================================
// EMAILS
// =============================================
model Email {
  id             String      @id @default(auto()) @map("_id") @db.ObjectId
  companyId      String      @db.ObjectId
  contactId      String?     @db.ObjectId
  subject        String
  body           String
  status         EmailStatus @default(DRAFT)
  serviceMode    ServiceMode @default(ERP)
  version        Int         @default(1)
  wordCount      Int         @default(0)
  reviewScores   Json?
  sentAt         DateTime?
  openedAt       DateTime?
  repliedAt      DateTime?
  bounced        Boolean     @default(false)
  messageId      String?
  gmailMessageId String?
  gmailThreadId  String?
  provider       String?
  tone           String      @default("professional")
  focusPainPoint String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  company      Company       @relation(fields: [companyId], references: [id])
  contact      Contact?      @relation(fields: [contactId], references: [id])
  approvals    Approval[]
  conversation Conversation?

  @@index([companyId])
  @@index([status])
  @@index([sentAt])
  @@index([gmailThreadId])
}

enum EmailStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SENDING
  SENT
  SKIPPED
}

// =============================================
// AEO RESEARCH
// =============================================
model AEOResearch {
  id                    String   @id @default(auto()) @map("_id") @db.ObjectId
  companyId             String   @db.ObjectId
  appearsInAIAnswers    Boolean  @default(false)
  aiAnswerEvidence      String[]
  competitorAIPresence  String[]
  faqContentGaps        String[]
  schemaMarkupStatus    String?
  brandMentions         String[]
  contentQualityNotes   String[]
  aeoOpportunities      Json     @default("[]")
  primaryOpportunity    String?
  opportunityScore      Float    @default(0)
  summary               String
  rawData               Json?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId])
}

// =============================================
// CONVERSATIONS (reply threads)
// =============================================
model Conversation {
  id              String             @id @default(auto()) @map("_id") @db.ObjectId
  companyId       String             @db.ObjectId
  emailId         String             @unique @db.ObjectId
  gmailThreadId   String?
  status          ConversationStatus @default(AWAITING_REPLY)
  intent          String?
  intentScore     Float?
  lastMessageAt   DateTime?
  followUpAt      DateTime?
  followUpNote    String?
  suppressedAt    DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  company  Company               @relation(fields: [companyId], references: [id])
  email    Email                 @relation(fields: [emailId], references: [id])
  messages ConversationMessage[]

  @@index([companyId])
  @@index([status])
  @@index([gmailThreadId])
  @@index([followUpAt])
}

enum ConversationStatus {
  AWAITING_REPLY
  REPLIED
  DRAFT_READY
  PENDING_SEND_APPROVAL
  REPLY_SENT
  MEETING_BOOKED
  FOLLOW_UP_SCHEDULED
  FOLLOW_UP_PREPARING
  REPLY_SENDING
  SUPPRESSED
  CLOSED
}

model ConversationMessage {
  id             String      @id @default(auto()) @map("_id") @db.ObjectId
  conversationId String      @db.ObjectId
  direction      MessageDir
  subject        String?
  body           String
  fromEmail      String?
  toEmail        String?
  gmailMessageId String?
  rfcMessageId   String?
  intent         String?
  intentDetails  Json?
  draftBody      String?
  approvedAt     DateTime?
  sentAt         DateTime?
  createdAt      DateTime    @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id])

  @@index([conversationId])
  @@index([direction])
  @@index([createdAt])
}

enum MessageDir {
  OUTBOUND
  INBOUND
  DRAFT
}

// =============================================
// APPROVALS
// =============================================
model Approval {
  id           String         @id @default(auto()) @map("_id") @db.ObjectId
  emailId      String         @db.ObjectId
  userId       String         @db.ObjectId
  action       ApprovalAction
  reason       String?
  instructions String?
  createdAt    DateTime       @default(now())

  email Email @relation(fields: [emailId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  @@index([emailId])
  @@index([userId])
}

enum ApprovalAction {
  APPROVED
  SKIPPED
  REVISED
  SENT
}

// =============================================
// ACTIVITIES
// =============================================
model Activity {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  type       String
  entityType String
  entityId   String
  companyId  String?  @db.ObjectId
  userId     String?  @db.ObjectId
  meta       Json?
  createdAt  DateTime @default(now())

  company Company? @relation(fields: [companyId], references: [id])
  user    User?    @relation(fields: [userId], references: [id])

  @@index([type])
  @@index([companyId])
  @@index([createdAt])
}

// =============================================
// INTEGRATIONS
// =============================================
model Integration {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  provider     String    @unique
  isActive     Boolean   @default(false)
  config       Json      @default("{}")
  lastTestedAt DateTime?
  lastErrorAt  DateTime?
  lastError    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// =============================================
// WAITLIST LEADS (Ecommerce — separate collection)
// =============================================
model WaitlistLead {
  id          String         @id @default(auto()) @map("_id") @db.ObjectId
  email       String
  name        String?
  source      String         @default("nofoal-waitlist")
  status      WaitlistStatus @default(PENDING)
  emailSentAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([status])
  @@index([email])
  @@index([createdAt])
  @@map("waitlist_leads")
}

enum WaitlistStatus {
  PENDING
  SENT
  REJECTED
}

// =============================================
// SETTINGS
// =============================================
model Setting {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}
